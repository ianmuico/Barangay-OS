{
  "name": "barangay-management",
  "version": "1.0.0",
  "description": "Barangay Management System - Offline-first desktop application",
  "main": "main/dist/index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "cd renderer && npx next dev -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build:next": "cd renderer && npx next build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:next && npm run build:main",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-rebuild"
  },
  "keywords": ["barangay", "management", "electron", "offline"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "uuid": "^9.0.0"
  }
}
